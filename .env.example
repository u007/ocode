# Connector settings reference (no secrets; secrets stored in OS keychain)
# Session key derived from master password and cached in OS keychain
CONNECTOR_SESSION_KEY_REF=keychain

# Postgres integration tests (`make test-postgres` sets this itself). Admin URL on a
# throwaway server: the tests create and drop their own databases. Test-only; not
# needed in a deployment environment.
OCODE_TEST_POSTGRES_URL=postgres://postgres:CHANGE_ME@127.0.0.1:55432/postgres?sslmode=disable

# Artifact publishing (publish/share project, Mode A / self-hosted).
# Only the vars below are read by ocode today. Mode B (hub-hosted) is not
# implemented yet, so its vars are reserved and listed here as a reminder.
OCODE_ARTIFACT_MAX_BYTES=104857600
# Invitation lifetime in days; invalid or <=0 falls back to the 7-day default.
OCODE_ARTIFACT_INVITE_TTL_DAYS=7
# Access-log retention in days; 0 keeps rows forever. Pruned at startup and
# at most once per hour afterwards.
OCODE_ARTIFACT_LOG_RETENTION_DAYS=30
# Reserved for Mode B (separate artifact origin); NOT read yet.
OCODE_ARTIFACT_ORIGIN=
# Reserved for Mode B (hub base URL; defaults to sync_url); NOT read yet.
OCODE_ARTIFACT_HUB_URL=
