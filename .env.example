# Connector settings reference (no secrets; secrets stored in OS keychain)
# Session key derived from master password and cached in OS keychain
CONNECTOR_SESSION_KEY_REF=keychain

# Postgres integration tests (`make test-postgres` sets this itself). Admin URL on a
# throwaway server: the tests create and drop their own databases. Test-only; not
# needed in a deployment environment.
OCODE_TEST_POSTGRES_URL=postgres://postgres:CHANGE_ME@127.0.0.1:55432/postgres?sslmode=disable

# Artifact publishing (publish/share project).
# Mode A (self-hosted) reads the limits below. Mode B (hub-hosted) resolves the
# hub from sync_url and needs no extra variable here; its access mode, password
# and invite emails travel in the publish request. OCODE_ARTIFACT_ORIGIN and
# OCODE_ARTIFACT_HUB_URL are still unread (reserved), so leave them empty.
OCODE_ARTIFACT_MAX_BYTES=104857600
# Invitation lifetime in days; invalid or <=0 falls back to the 7-day default.
OCODE_ARTIFACT_INVITE_TTL_DAYS=7
# Access-log retention in days; 0 keeps rows forever. Pruned at startup and
# at most once per hour afterwards.
OCODE_ARTIFACT_LOG_RETENTION_DAYS=30
# Reserved (separate artifact origin); NOT read yet.
OCODE_ARTIFACT_ORIGIN=
# Reserved (hub base URL override); NOT read yet — Mode B uses sync_url.
OCODE_ARTIFACT_HUB_URL=

# Config/auth sync (kakiit) server. Unset falls back to the production hub
# https://hub.mercstudio.com. The per-machine override from Settings > Backend >
# Sync server (ocodeconfig.json `sync_url`) wins over this variable. The
# messaging connectors' push/pull target resolves through the same chain.
OCODE_SYNC_URL=

# Cloud storage connectors (Phase 1): master password used to encrypt connector secrets at rest.
OCODE_CLOUD_MASTER_PASSWORD=

# Desktop packaging (macOS only, BUILD-TIME — not a deployment variable). Codesign
# identity for scripts/bundle-macos.sh; unset auto-detects an `ocode-dev` identity
# and otherwise falls back to ad-hoc (which orphans TCC grants on every rebuild).
# `make signing-cert` creates the identity. Servers never read this.
OCODE_CODESIGN_IDENTITY=

# kakiit LLM gateway (provider id `kakiit`, default base URL
# https://hub.mercstudio.com/api/llm). The credential normally lives in
# auth.json (`ocode /connect kakiit`); these env vars are the fallback
# override path. KAKIIT_BASE_URL also wins over the ocodeconfig.json
# `kakiit_base_url` field.
KAKIIT_API_KEY=
KAKIIT_BASE_URL=
