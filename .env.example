# Connector settings reference (no secrets; secrets stored in OS keychain)
# Session key derived from master password and cached in OS keychain
CONNECTOR_SESSION_KEY_REF=keychain

# Postgres integration tests (`make test-postgres` sets this itself). Admin URL on a
# throwaway server: the tests create and drop their own databases. Test-only; not
# needed in a deployment environment.
OCODE_TEST_POSTGRES_URL=postgres://postgres:CHANGE_ME@127.0.0.1:55432/postgres?sslmode=disable
